[ a                earl:Assertion;
  earl:assertedBy  <https://example.org/touchstone/harness>;
  earl:mode        earl:automatic;
  earl:result      [ a             earl:TestResult;
                     dcterms:date  "2026-10-14T21:33:08.755947415Z"^^<http://www.w3.org/2001/XMLSchema#dateTime>;
                     earl:outcome  earl:passed
                   ];
  earl:subject     <http://127.0.0.1:39239/lws/harness/>;
  earl:test        <https://example.org/touchstone/test/lws10/index/manifest#type-search-unindexed-relation>
] .

